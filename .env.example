# Copy this file to .env and replace every placeholder.
# .env is ignored by git and must never be committed.

# Required. Generate a fresh one, never reuse a key from a repository:
#   python -c "from django.core.management.utils import \
#     get_random_secret_key as k; print(k())"
SECRET_KEY=paste-a-freshly-generated-50-character-django-secret-key

# True for local development, False everywhere else.
DEBUG=True

# Comma-separated. Only consulted when DEBUG is False.
ALLOWED_HOSTS=127.0.0.1,localhost

# Google AI Studio key for Gemini Flash quiz generation. Missing or
# empty is reported by manage.py check as a warning, and every quiz
# generation then fails with a 500.
GEMINI_API_KEY=your-google-ai-studio-api-key

# Gemini model used for quiz generation. Leave it as it is unless a
# newer Flash model is out; the 2.x names are retired and answer 404.
GEMINI_MODEL=gemini-3.5-flash-lite

# True only behind HTTPS. Over plain http the browser drops a Secure
# cookie without a word, and every request after login looks like 401.
COOKIE_SECURE=False

# Comma-separated, no wildcard: credentials are sent with every request.
# Use 127.0.0.1, not localhost. They are different hosts, so the
# SameSite=Lax cookies would be treated as cross-site and dropped.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500

# Whisper model size: tiny, base, small, medium or large.
WHISPER_MODEL=base
